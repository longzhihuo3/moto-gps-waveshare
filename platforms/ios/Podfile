# AMap (高德) native navigation SDKs for on-device route planning and search.
# Run `pod install` after every `xcodegen generate` (the Pods project
# references MotoGPS.xcodeproj, which xcodegen regenerates).
platform :ios, '17.0'

target 'MotoGPS' do
  use_frameworks! :linkage => :static

  pod 'AMapNavi', '11.3.100'
  pod 'AMapSearch', '9.8.1'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
    end
  end
end
